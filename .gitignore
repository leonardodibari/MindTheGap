# Local Python environments
.venv/
.conda/

# Python caches and tooling
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Secrets and local configuration
.env
.env.*
!.env.example

# Generated artifacts
artifacts/
models/
outputs/

# Keep the compact best neural checkpoints requested by the modeling notebooks.
!results/models/
!results/models/schnet_best_random.pt
!results/models/schnet_best_scaffold.pt

# Keep the compact, presentation-ready additional-analysis artifacts.
!outputs/
outputs/*
!outputs/additional_analysis/
!outputs/additional_analysis/**

# The supplied dataset is 192 MB and exceeds GitHub's 100 MB file limit.
# Keep it locally at datasets/base.csv.
datasets/*.csv

# Editors and operating systems
.DS_Store
.idea/
.vscode/
